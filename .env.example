# PostgreSQL business database (SQLAlchemy async driver)
POSTGRES_PASSWORD=change-me-before-deployment
DATABASE_URL=postgresql+asyncpg://bytedance@localhost:5432/furniscope

# LangGraph official PostgreSQL checkpointer (psycopg connection string)
LANGGRAPH_DATABASE_URL=postgresql://bytedance@localhost:5432/furniscope

# Redis Streams queue used by the independent long-running worker.
REDIS_URL=redis://localhost:6379/0
JOB_QUEUE_MODE=in_process
WORKER_CONCURRENCY=2
WORKER_BLOCK_MS=5000
WORKER_LEASE_MS=120000
WORKER_MAX_ATTEMPTS=3
WORKER_JOB_TIMEOUT_SECONDS=900

# Cainiao Hackathon Token Plan (OpenAI-compatible). Keep the assigned key only
# in .env or the deployment secret manager; never commit it.
ALIYUN_MODEL_ROUTER_API_KEY=
ALIYUN_MODEL_ROUTER_CHAT_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ALIYUN_MODEL_ROUTER_CHAT_PATH=/chat/completions
ALIYUN_MODEL_ROUTER_TEXT_MODEL=qwen3.7-plus
ALIYUN_MODEL_ROUTER_EMBEDDING_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ALIYUN_MODEL_ROUTER_EMBEDDING_PATH=/embeddings
ALIYUN_MODEL_ROUTER_EMBEDDING_MODEL=text-embedding-v4
ALIYUN_MODEL_ROUTER_EMBEDDING_DIMENSIONS=1024
ALIYUN_MODEL_ROUTER_RERANK_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-api/v1
ALIYUN_MODEL_ROUTER_RERANK_PATH=/reranks
ALIYUN_MODEL_ROUTER_RERANK_MODEL=qwen3-rerank
ALIYUN_MODEL_ROUTER_TIMEOUT_SECONDS=90
ALIYUN_MODEL_ROUTER_MAX_RETRIES=2

# Official DeepSeek chat fallback when Token Plan quota is exhausted.
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_PATH=/chat/completions
DEEPSEEK_TEXT_MODEL=deepseek-chat

# FastAPI JWT contract. Set private/public key material only in local secret env.
FURNISCOPE_JWT_PRIVATE_KEY=
FURNISCOPE_JWT_PUBLIC_KEYS_JSON=
FURNISCOPE_JWT_ISSUER=furniscope-api
FURNISCOPE_JWT_AUDIENCE=furniscope-web
ACCESS_TOKEN_TTL_SECONDS=900
JWT_CLOCK_SKEW_SECONDS=60
REFRESH_TOKEN_TTL_SECONDS=2592000

APP_ENV=development
APP_DEBUG=true
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:42817","http://localhost:42817"]
ENABLE_SYNTHETIC_DEMO=false
ANALYSIS_ONTOLOGY_VERSION=sofa-ontology-v1
ANALYSIS_SCORING_VERSION=opportunity-score-v2
ANALYSIS_PROMPT_BUNDLE_VERSION=furniscope-agent-v1
# token_plan_demo calls the event API for report generation while retaining
# explicitly-labelled synthetic demo data. Use external for a real-data worker.
ANALYSIS_MODEL_ROUTE_VERSION=token-plan-route-v1
ANALYSIS_WORKER_MODE=external
ANALYSIS_TOOL_MODE=external
PRODUCT_PARSE_MODE=model
UPLOAD_MAX_BYTES=26214400
# Required in production; generate a high-entropy value and inject it only at runtime.
INTERNAL_SERVICE_TOKEN=

# Existing Sales Forecast V4 engine and trusted, read-only model state.
# Paths are resolved when the API starts; model paths are never accepted from clients.
FORECAST_ENABLED=true
FORECAST_ENGINE_ROOT=backend/furniscope_forecast
FORECAST_STATE_DIR=forecast_assets/state
FORECAST_ARTIFACT_ROOT=forecast_assets/tenants
FORECAST_MODEL_VERSION=sales-forecast-v4
FORECAST_MAX_PAIRS=100

# Optional operations/monitoring profiles.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
# Required when starting: docker compose --profile monitoring up -d
GRAFANA_ADMIN_PASSWORD=
